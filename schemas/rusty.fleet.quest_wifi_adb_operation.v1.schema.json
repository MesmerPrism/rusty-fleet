{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/rusty-fleet/schemas/rusty.fleet.quest_wifi_adb_operation.v1.schema.json",
  "title": "Rusty Fleet Quest Wi-Fi ADB operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "action_id", "lifecycle", "preview", "confirmed_at_ms", "targets", "updated_at_ms"],
  "properties": {
    "schema": {"const": "rusty.fleet.quest_wifi_adb_operation.v1"},
    "operation_id": {"$ref": "#/$defs/portableId"},
    "action_id": {"const": "quest.wifi-adb-control"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "preview": {"$ref": "#/$defs/preview"},
    "confirmed_at_ms": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "targets": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/targetLedger"}},
    "updated_at_ms": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "enum": ["status", "request_wireless_adb", "enable_request_after_boot", "disable_request_after_boot", "disable_wireless_adb", "enable_classic_tcpip_from_usb"]
    },
    "routeMode": {"enum": ["none", "modern_tls", "classic_tcpip"]},
    "wearerApproval": {"enum": ["not_applicable", "pending", "accepted", "rejected", "unknown"]},
    "lifecycle": {
      "enum": ["proposed", "accepted", "rejected", "dispatched", "running", "applied", "failed", "expired", "cancellation_requested", "cancelled"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repo_id", "capability_id", "provider_contract", "receipt_schema", "transport", "private_target_resolution"],
      "properties": {
        "owner_repo_id": {"const": "questionable-file-manager"},
        "capability_id": {"const": "questionable-file-manager.quest-wifi-adb-provider"},
        "provider_contract": {"const": "questionable.file_manager.fleet_connectivity_provider.v1"},
        "receipt_schema": {"const": "questionable.file_manager.quest_wifi_adb_receipt.v1"},
        "transport": {"const": "pinned_local_subprocess"},
        "private_target_resolution": {"const": "provider_owned_credential_profile"}
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "identity_revision", "capability_id", "capability_evidence_revision", "capability_owner", "support", "enablement", "authorization", "reachability", "freshness", "observed_at_ms", "fresh_until_ms", "evaluated_at_ms", "eligible", "reason_code", "message"],
      "properties": {
        "device_id": {"$ref": "#/$defs/portableId"},
        "identity_revision": {"type": "integer", "minimum": 1},
        "capability_id": {"const": "questionable-file-manager.quest-wifi-adb-provider"},
        "capability_evidence_revision": {"type": "integer", "minimum": 1},
        "capability_owner": {"const": "questionable-file-manager"},
        "support": {"enum": ["supported", "unsupported", "unknown"]},
        "enablement": {"enum": ["enabled", "disabled", "unknown"]},
        "authorization": {"enum": ["authorized", "unauthorized", "restricted", "unknown"]},
        "reachability": {"enum": ["reachable", "disconnected", "unavailable", "unknown"]},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "observed_at_ms": {"type": "integer", "minimum": 0},
        "fresh_until_ms": {"type": "integer", "minimum": 0},
        "evaluated_at_ms": {"type": "integer", "minimum": 0},
        "eligible": {"type": "boolean"},
        "reason_code": {"$ref": "#/$defs/portableId"},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "preview_id", "operation_id", "action_id", "action", "created_at_ms", "expires_at_ms", "fleet_revision", "owner", "targets"],
      "properties": {
        "schema": {"const": "rusty.fleet.quest_wifi_adb_preview.v1"},
        "preview_id": {"$ref": "#/$defs/portableId"},
        "operation_id": {"$ref": "#/$defs/portableId"},
        "action_id": {"const": "quest.wifi-adb-control"},
        "action": {"$ref": "#/$defs/action"},
        "created_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 0},
        "fleet_revision": {"type": "integer", "minimum": 1},
        "owner": {"$ref": "#/$defs/owner"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/preflight"}}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "operation_id", "preview_id", "device_id", "identity_revision", "action", "issued_at_ms", "expires_at_ms"],
      "properties": {
        "schema": {"const": "rusty.fleet.quest_wifi_adb_owner_invocation.v1"},
        "request_id": {"$ref": "#/$defs/portableId"},
        "operation_id": {"$ref": "#/$defs/portableId"},
        "preview_id": {"$ref": "#/$defs/portableId"},
        "device_id": {"$ref": "#/$defs/portableId"},
        "identity_revision": {"type": "integer", "minimum": 1},
        "action": {"$ref": "#/$defs/action"},
        "issued_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 0}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "request_id", "operation_id", "preview_id", "device_id", "identity_revision", "action", "route_mode", "request_delivered", "kiosk_setting_applied", "request_after_boot_enabled", "wearer_approval", "listener_discovered", "effect_applied", "outcome", "evidence_sha256", "observed_at_ms"],
      "properties": {
        "schema": {"const": "questionable.file_manager.quest_wifi_adb_receipt.v1"},
        "request_id": {"$ref": "#/$defs/portableId"},
        "operation_id": {"$ref": "#/$defs/portableId"},
        "preview_id": {"$ref": "#/$defs/portableId"},
        "device_id": {"$ref": "#/$defs/portableId"},
        "identity_revision": {"type": "integer", "minimum": 1},
        "action": {"$ref": "#/$defs/action"},
        "route_mode": {"$ref": "#/$defs/routeMode"},
        "request_delivered": {"type": "boolean"},
        "kiosk_setting_applied": {"type": "boolean"},
        "request_after_boot_enabled": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "wearer_approval": {"$ref": "#/$defs/wearerApproval"},
        "listener_discovered": {"type": "boolean"},
        "effect_applied": {"type": "boolean"},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at_ms": {"type": "integer", "minimum": 0}
      }
    },
    "termuxProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "proof_id", "owner_id", "device_id", "identity_revision", "source_epoch", "source_revision", "evidence_revision", "route_mode", "discovery_mode", "listener_discovered", "shell_identity", "available", "evidence_sha256", "observed_at_ms", "fresh_until_ms"],
      "properties": {
        "schema": {"const": "rusty.fleet.quest_wifi_adb_termux_proof.v1"},
        "proof_id": {"$ref": "#/$defs/portableId"},
        "owner_id": {"const": "quest-termux-lab"},
        "device_id": {"$ref": "#/$defs/portableId"},
        "identity_revision": {"type": "integer", "minimum": 1},
        "source_epoch": {"$ref": "#/$defs/portableId"},
        "source_revision": {"type": "integer", "minimum": 1},
        "evidence_revision": {"type": "integer", "minimum": 1},
        "route_mode": {"const": "modern_tls"},
        "discovery_mode": {"enum": ["tls_nsd", "tls_mdns"]},
        "listener_discovered": {"type": "boolean"},
        "shell_identity": {"oneOf": [{"const": "uid=2000(shell)"}, {"type": "null"}]},
        "available": {"type": "boolean"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at_ms": {"type": "integer", "minimum": 0},
        "fresh_until_ms": {"type": "integer", "minimum": 0}
      }
    },
    "targetLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "identity_revision", "preflight", "lifecycle", "invocation", "receipt", "termux_proof", "termux_usable", "failure_code", "updated_at_ms"],
      "properties": {
        "device_id": {"$ref": "#/$defs/portableId"},
        "identity_revision": {"type": "integer", "minimum": 1},
        "preflight": {"$ref": "#/$defs/preflight"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "invocation": {"oneOf": [{"$ref": "#/$defs/invocation"}, {"type": "null"}]},
        "receipt": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "termux_proof": {"oneOf": [{"$ref": "#/$defs/termuxProof"}, {"type": "null"}]},
        "termux_usable": {"type": "boolean"},
        "failure_code": {"oneOf": [{"$ref": "#/$defs/portableId"}, {"type": "null"}]},
        "updated_at_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
