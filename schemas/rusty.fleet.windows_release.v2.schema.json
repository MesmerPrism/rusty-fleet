{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/schemas/rusty.fleet.windows_release.v2.schema.json",
  "title": "Rusty Fleet Windows release payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset",
    "channel",
    "descriptor_id",
    "expires_at_ms",
    "issued_at_ms",
    "product",
    "schema",
    "validity_duration_ms",
    "version"
  ],
  "properties": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installer_protocol",
        "media_type",
        "name",
        "sha256",
        "signer_certificate_sha256",
        "size_bytes",
        "url"
      ],
      "properties": {
        "installer_protocol": {
          "const": "rusty.fleet.guided_setup.v1"
        },
        "media_type": {
          "const": "application/vnd.microsoft.portable-executable"
        },
        "name": {
          "enum": [
            "RustyFleet-Alpha-Setup.exe",
            "RustyFleet-Setup.exe"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signer_certificate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/MesmerPrism/rusty-fleet/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(?:-alpha\\.[1-9][0-9]*)?/RustyFleet(?:-Alpha)?-Setup\\.exe$"
        }
      }
    },
    "channel": {
      "enum": [
        "dev",
        "alpha",
        "preview",
        "stable"
      ]
    },
    "descriptor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "product": {
      "const": "rusty-fleet"
    },
    "schema": {
      "const": "rusty.fleet.windows_release.v2"
    },
    "validity_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "description": "Consumers MUST require expires_at_ms = issued_at_ms + validity_duration_ms."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "channel": { "const": "alpha" } },
        "required": ["channel"]
      },
      "then": {
        "properties": {
          "asset": {
            "properties": {
              "name": { "const": "RustyFleet-Alpha-Setup.exe" },
              "url": {
                "pattern": "/v[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[1-9][0-9]*/RustyFleet-Alpha-Setup\\.exe$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "asset": {
            "properties": {
              "name": { "const": "RustyFleet-Setup.exe" },
              "url": {
                "pattern": "/v[0-9]+\\.[0-9]+\\.[0-9]+/RustyFleet-Setup\\.exe$"
              }
            }
          }
        }
      }
    }
  ]
}
