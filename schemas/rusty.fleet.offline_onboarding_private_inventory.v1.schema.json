{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-fleet/schemas/rusty.fleet.offline_onboarding_private_inventory.v1.schema.json",
  "title": "Rusty Fleet offline onboarding private inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "output_root",
    "tool_manifest_sha256",
    "tool_executable_sha256",
    "quest_profile_owner_source_sha256",
    "quest_profile_owner_fixture_sha256",
    "root_identity",
    "entries",
    "state"
  ],
  "properties": {
    "schema": { "const": "rusty.fleet.offline_onboarding_private_inventory.v1" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "output_root": { "type": "string", "minLength": 3, "maxLength": 32767 },
    "tool_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "tool_executable_sha256": { "$ref": "#/$defs/sha256" },
    "quest_profile_owner_source_sha256": { "$ref": "#/$defs/sha256" },
    "quest_profile_owner_fixture_sha256": { "$ref": "#/$defs/sha256" },
    "root_identity": { "$ref": "#/$defs/identity" },
    "entries": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "kind", "identity"],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^(hub|devices)$|^hub/enrollment\\.private-config\\.json$|^devices/device-[0-9a-f]{64}$|^devices/device-[0-9a-f]{64}/fleet-agent\\.(seed|profile\\.json|public-key-record\\.json)$"
          },
          "kind": { "enum": ["directory", "file"] },
          "identity": { "$ref": "#/$defs/identity" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "file" } } },
            "then": { "required": ["sha256"] },
            "else": { "not": { "required": ["sha256"] } }
          }
        ]
      }
    },
    "state": { "const": "generated-not-installed-or-enrolled" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_serial_number", "file_id", "number_of_links", "acl_sha256"],
      "properties": {
        "volume_serial_number": { "type": "integer", "minimum": 0 },
        "file_id": { "type": "integer", "minimum": 0 },
        "number_of_links": { "type": "integer", "minimum": 1 },
        "acl_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
