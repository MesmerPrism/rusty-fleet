{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MesmerPrism/rusty-fleet/schemas/rusty.fleet.offline_onboarding_plan.v1.schema.json",
  "title": "Rusty Fleet offline onboarding plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_sha256", "tool_manifest_sha256", "tool_executable_sha256", "tool_source_commit", "quest_profile_owner_source_sha256", "quest_profile_owner_fixture_sha256", "device_ids", "output_files", "effects", "non_claims", "plan_sha256"],
  "properties": {
    "schema": { "const": "rusty.fleet.offline_onboarding_plan.v1" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "tool_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "tool_executable_sha256": { "$ref": "#/$defs/sha256" },
    "tool_source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "quest_profile_owner_source_sha256": { "$ref": "#/$defs/sha256" },
    "quest_profile_owner_fixture_sha256": { "$ref": "#/$defs/sha256" },
    "device_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "output_files": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "effects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "non_claims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
