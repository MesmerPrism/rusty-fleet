{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rusty.fleet.validation_run_receipt.v1.schema.json",
  "title": "Rusty Fleet validation run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "mode", "requested_profile", "effective_profile", "required_profile", "allow_dirty_source", "config_sha256", "risk_manifest", "git", "commands", "started_at", "finished_at", "duration_ms", "result", "limitations"],
  "properties": {
    "schema": { "const": "rusty.fleet.validation_run_receipt.v1" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "mode": { "enum": ["plan", "execute"] },
    "requested_profile": {
      "type": ["string", "null"],
      "enum": [null, "focused", "standard", "release", "Quick", "Standard", "Deep"]
    },
    "effective_profile": { "enum": ["focused", "standard", "release"] },
    "required_profile": { "enum": ["focused", "standard", "release"] },
    "allow_dirty_source": { "type": "boolean" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "risk_manifest": {
      "$ref": "rusty.fleet.change_risk_manifest.v1.schema.json"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "drift_detected"],
      "properties": {
        "before": { "$ref": "#/$defs/git_snapshot" },
        "after": {
          "oneOf": [
            { "$ref": "#/$defs/git_snapshot" },
            { "type": "null" }
          ]
        },
        "drift_detected": { "type": "boolean" }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "arguments", "timeout_seconds", "status", "exit_code", "started_at", "finished_at", "duration_ms", "timed_out", "failure_reason", "cleanup"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
          },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["planned", "passed", "failed", "timed_out", "not_run"] },
          "exit_code": { "type": ["integer", "null"] },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" },
          "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
          "timed_out": { "type": "boolean" },
          "failure_reason": {
            "type": ["string", "null"],
            "enum": [null, "timeout", "nonzero-exit", "owned-child-leak", "cleanup-incomplete", "cleanup-unverified", "launch-error"]
          },
          "cleanup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempted",
              "completed",
              "drain_grace_ms",
              "drain_elapsed_ms",
              "post_exit_active_process_count",
              "pre_termination_active_process_count",
              "pre_termination_observation",
              "pre_termination_observation_budget_ms",
              "pre_termination_observation_elapsed_ms",
              "pre_termination_processes",
              "survivors"
            ],
            "properties": {
              "attempted": { "type": "boolean" },
              "completed": { "type": "boolean" },
              "drain_grace_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "drain_elapsed_ms": { "type": "integer", "minimum": 0 },
              "post_exit_active_process_count": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "pre_termination_active_process_count": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "pre_termination_observation": {
                "enum": [
                  "not-required",
                  "complete",
                  "truncated",
                  "partial",
                  "unavailable"
                ]
              },
              "pre_termination_observation_budget_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "pre_termination_observation_elapsed_ms": {
                "type": "integer",
                "minimum": 0
              },
              "pre_termination_processes": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pid", "image_basename", "lookup_status"],
                  "properties": {
                    "pid": { "type": "integer", "minimum": 1 },
                    "image_basename": {
                      "type": ["string", "null"],
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                    },
                    "lookup_status": { "enum": ["observed", "unavailable"] }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "lookup_status": { "const": "observed" } },
                        "required": ["lookup_status"]
                      },
                      "then": {
                        "properties": { "image_basename": { "type": "string" } }
                      },
                      "else": {
                        "properties": { "image_basename": { "type": "null" } }
                      }
                    }
                  ]
                }
              },
              "survivors": { "type": "array", "items": { "type": "integer" } }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "pre_termination_observation": { "const": "not-required" }
                  },
                  "required": ["pre_termination_observation"]
                },
                "then": {
                  "properties": {
                    "pre_termination_active_process_count": { "type": "null" },
                    "pre_termination_observation_budget_ms": { "const": 0 },
                    "pre_termination_observation_elapsed_ms": { "const": 0 },
                    "pre_termination_processes": { "maxItems": 0 }
                  }
                },
                "else": {
                  "properties": {
                    "pre_termination_active_process_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pre_termination_observation_budget_ms": { "const": 1000 }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "pre_termination_observation": { "const": "truncated" }
                  },
                  "required": ["pre_termination_observation"]
                },
                "then": {
                  "properties": {
                    "pre_termination_active_process_count": {
                      "type": "integer",
                      "minimum": 65
                    },
                    "pre_termination_processes": {
                      "minItems": 64,
                      "maxItems": 64
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "pre_termination_observation": { "const": "unavailable" }
                  },
                  "required": ["pre_termination_observation"]
                },
                "then": {
                  "properties": {
                    "pre_termination_processes": { "maxItems": 0 }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "enum": ["planned", "not_run"] } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "exit_code": { "type": "null" },
                "started_at": { "type": "null" },
                "finished_at": { "type": "null" },
                "duration_ms": { "type": "null" },
                "timed_out": { "const": false },
                "failure_reason": { "type": "null" },
                "cleanup": {
                  "properties": {
                    "attempted": { "const": false },
                    "completed": { "const": true },
                    "drain_grace_ms": { "const": 0 },
                    "drain_elapsed_ms": { "const": 0 },
                    "post_exit_active_process_count": { "type": "null" },
                    "pre_termination_active_process_count": { "type": "null" },
                    "pre_termination_observation": { "const": "not-required" },
                    "pre_termination_observation_budget_ms": { "const": 0 },
                    "pre_termination_observation_elapsed_ms": { "const": 0 },
                    "pre_termination_processes": { "maxItems": 0 },
                    "survivors": { "maxItems": 0 }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "passed" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "exit_code": { "const": 0 },
                "started_at": { "type": "string", "format": "date-time" },
                "finished_at": { "type": "string", "format": "date-time" },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "timed_out": { "const": false },
                "failure_reason": { "type": "null" },
                "cleanup": {
                  "properties": {
                    "attempted": { "const": false },
                    "completed": { "const": true },
                    "drain_grace_ms": { "const": 5000 },
                    "post_exit_active_process_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pre_termination_active_process_count": { "type": "null" },
                    "pre_termination_observation": { "const": "not-required" },
                    "pre_termination_observation_budget_ms": { "const": 0 },
                    "pre_termination_observation_elapsed_ms": { "const": 0 },
                    "pre_termination_processes": { "maxItems": 0 },
                    "survivors": { "maxItems": 0 }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "failed" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "exit_code": { "type": "integer" },
                "started_at": { "type": "string", "format": "date-time" },
                "finished_at": { "type": "string", "format": "date-time" },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "timed_out": { "const": false },
                "failure_reason": {
                  "enum": ["nonzero-exit", "owned-child-leak", "cleanup-unverified"]
                },
                "cleanup": {
                  "properties": { "attempted": { "const": true } }
                }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "timed_out" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "exit_code": { "type": "null" },
                "started_at": { "type": "string", "format": "date-time" },
                "finished_at": { "type": "string", "format": "date-time" },
                "duration_ms": { "type": "integer", "minimum": 0 },
                "timed_out": { "const": true },
                "failure_reason": { "enum": ["timeout", "cleanup-unverified"] },
                "cleanup": {
                  "properties": { "attempted": { "const": true } }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "failure_reason": { "const": "owned-child-leak" }
              },
              "required": ["failure_reason"]
            },
            "then": {
              "properties": {
                "exit_code": { "const": 0 },
                "cleanup": {
                  "properties": {
                    "drain_grace_ms": { "const": 5000 },
                    "post_exit_active_process_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pre_termination_active_process_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pre_termination_observation": {
                      "enum": ["complete", "truncated", "partial", "unavailable"]
                    },
                    "pre_termination_observation_budget_ms": { "const": 1000 }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["planned", "in_progress", "passed", "failed", "rejected"] },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requested_profile": { "enum": ["focused", "Quick"] }
        },
        "required": ["requested_profile"]
      },
      "then": {
        "properties": {
          "effective_profile": { "const": "focused" },
          "required_profile": { "const": "focused" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requested_profile": { "enum": ["standard", "Standard"] }
        },
        "required": ["requested_profile"]
      },
      "then": {
        "properties": {
          "effective_profile": { "const": "standard" },
          "required_profile": { "enum": ["focused", "standard"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requested_profile": { "enum": ["release", "Deep"] }
        },
        "required": ["requested_profile"]
      },
      "then": {
        "properties": { "effective_profile": { "const": "release" } }
      }
    },
    {
      "if": {
        "properties": {
          "requested_profile": { "type": "null" },
          "required_profile": { "const": "focused" }
        },
        "required": ["requested_profile", "required_profile"]
      },
      "then": {
        "properties": { "effective_profile": { "const": "focused" } }
      }
    },
    {
      "if": {
        "properties": {
          "requested_profile": { "type": "null" },
          "required_profile": { "const": "standard" }
        },
        "required": ["requested_profile", "required_profile"]
      },
      "then": {
        "properties": { "effective_profile": { "const": "standard" } }
      }
    },
    {
      "if": {
        "properties": {
          "requested_profile": { "type": "null" },
          "required_profile": { "const": "release" }
        },
        "required": ["requested_profile", "required_profile"]
      },
      "then": {
        "properties": { "effective_profile": { "const": "release" } }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "plan" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "result": { "const": "planned" },
          "git": {
            "properties": {
              "after": { "type": "null" },
              "drift_detected": { "const": false }
            }
          },
          "commands": {
            "items": { "properties": { "status": { "const": "planned" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "in_progress" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "mode": { "const": "execute" },
          "git": {
            "properties": {
              "after": { "type": "null" },
              "drift_detected": { "const": false }
            }
          },
          "commands": {
            "items": { "properties": { "status": { "const": "planned" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "passed" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "mode": { "const": "execute" },
          "git": {
            "properties": {
              "after": { "$ref": "#/$defs/git_snapshot" },
              "drift_detected": { "const": false }
            }
          },
          "commands": {
            "items": { "properties": { "status": { "const": "passed" } } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "failed" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "mode": { "const": "execute" },
          "git": {
            "properties": {
              "after": { "$ref": "#/$defs/git_snapshot" },
              "drift_detected": { "const": false }
            }
          },
          "commands": {
            "contains": {
              "properties": { "status": { "enum": ["failed", "timed_out"] } },
              "required": ["status"]
            },
            "items": {
              "properties": {
                "status": { "enum": ["passed", "failed", "timed_out", "not_run"] }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "rejected" } },
        "required": ["result"]
      },
      "then": {
        "properties": { "mode": { "const": "execute" } },
        "oneOf": [
          {
            "properties": {
              "allow_dirty_source": { "const": false },
              "git": {
                "properties": {
                  "before": {
                    "properties": { "clean": { "const": false } },
                    "required": ["clean"]
                  },
                  "after": { "type": "null" },
                  "drift_detected": { "const": false }
                }
              },
              "commands": {
                "items": { "properties": { "status": { "const": "planned" } } }
              }
            }
          },
          {
            "properties": {
              "git": {
                "properties": {
                  "after": { "$ref": "#/$defs/git_snapshot" },
                  "drift_detected": { "const": true }
                }
              },
              "commands": {
                "items": {
                  "properties": {
                    "status": { "enum": ["passed", "failed", "timed_out", "not_run"] }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "result": { "enum": ["passed", "failed"] },
          "git": {
            "properties": {
              "before": {
                "properties": { "clean": { "const": false } },
                "required": ["clean"]
              }
            },
            "required": ["before"]
          }
        },
        "required": ["result", "git"]
      },
      "then": {
        "properties": { "allow_dirty_source": { "const": true } }
      }
    },
    {
      "if": {
        "properties": {
          "git": {
            "properties": { "drift_detected": { "const": true } },
            "required": ["drift_detected"]
          }
        },
        "required": ["git"]
      },
      "then": {
        "properties": { "result": { "const": "rejected" } }
      }
    }
  ],
  "$defs": {
    "git_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "detached", "index_sha256", "clean", "paths"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "detached": { "type": "boolean" },
        "index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clean": { "type": "boolean" },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "path", "original_path", "sha256"],
            "properties": {
              "status": { "type": "string", "pattern": "^[ MADRCUT?!]{2}$" },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
              },
              "original_path": {
                "type": ["string", "null"],
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
              },
              "sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
