{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesmerprism.com/rusty-fleet/schemas/rusty.fleet.package_install_release_progress.v1.schema.json",
  "title": "Rusty Fleet package install/release progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "operation_sha256",
    "lifecycle",
    "retention",
    "archived_at_ms",
    "created_at_ms",
    "last_transition_ms",
    "total_targets",
    "eligible_targets",
    "excluded_targets",
    "preview_ready",
    "approved",
    "dispatch_ready",
    "claimed",
    "owner_acknowledged",
    "staged",
    "awaiting_wearer",
    "cancellation_requested",
    "recovery_required",
    "applied",
    "failed",
    "expired",
    "cancelled",
    "retained_owner_claims",
    "max_parallelism",
    "terminal_targets",
    "terminal",
    "archive_eligible"
  ],
  "properties": {
    "schema": { "const": "rusty.fleet.package_install_release_progress.v1" },
    "operation_id": { "$ref": "#/$defs/portableId" },
    "operation_sha256": { "$ref": "#/$defs/sha256" },
    "lifecycle": {
      "enum": [
        "proposed", "accepted", "rejected", "dispatched", "running", "applied",
        "failed", "expired", "cancellation_requested", "cancelled"
      ]
    },
    "retention": { "enum": ["active", "archived"] },
    "archived_at_ms": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "created_at_ms": { "type": "integer", "minimum": 0 },
    "last_transition_ms": { "type": "integer", "minimum": 0 },
    "total_targets": { "$ref": "#/$defs/count" },
    "eligible_targets": { "$ref": "#/$defs/count" },
    "excluded_targets": { "$ref": "#/$defs/count" },
    "preview_ready": { "$ref": "#/$defs/count" },
    "approved": { "$ref": "#/$defs/count" },
    "dispatch_ready": { "$ref": "#/$defs/count" },
    "claimed": { "$ref": "#/$defs/count" },
    "owner_acknowledged": { "$ref": "#/$defs/count" },
    "staged": { "$ref": "#/$defs/count" },
    "awaiting_wearer": { "$ref": "#/$defs/count" },
    "cancellation_requested": { "$ref": "#/$defs/count" },
    "recovery_required": { "$ref": "#/$defs/count" },
    "applied": { "$ref": "#/$defs/count" },
    "failed": { "$ref": "#/$defs/count" },
    "expired": { "$ref": "#/$defs/count" },
    "cancelled": { "$ref": "#/$defs/count" },
    "retained_owner_claims": { "$ref": "#/$defs/count" },
    "max_parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
    "terminal_targets": { "$ref": "#/$defs/count" },
    "terminal": { "type": "boolean" },
    "archive_eligible": { "type": "boolean" }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 10000 }
  }
}
