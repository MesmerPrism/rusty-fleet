    },
    {
      "rule_id": "validation-receipt-schema",
      "match": "exact",
      "path": "schemas/rusty.fleet.validation_run_receipt.v1.schema.json"
    },
    {
      "rule_id": "validation-repository-gate",
      "match": "exact",
      "path": "tools/Test-Repo.ps1"
    },
    {
      "rule_id": "validation-risk-policy",
      "match": "exact",
      "path": "config/fleet-validation-risk.v1.json"
    }
