<Window x:Class="RustyFleet.FleetConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rusty Fleet"
        Icon="Assets/rusty-fleet.ico"
        Width="1500"
        Height="900"
        MinWidth="1000"
        MinHeight="640"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="InspectorHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <DataTemplate x:Key="EvidenceFactTemplate">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label}"
                           Style="{StaticResource InspectorLabel}" />
                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}"
                           TextWrapping="Wrap"
                           Opacity="0.72" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="390" MinWidth="340" MaxWidth="620" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="14"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                AutomationProperties.Name="Primary navigation">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Rusty Fleet"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="4,4,4,18" />
                    <Button Content="Fleet"
                            IsDefault="True"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Fleet, current page" />
                    <Button Content="Attention · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Operations · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Media · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Audit · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Enrollment · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Settings · planned"
                            IsEnabled="False"
                            HorizontalContentAlignment="Left" />
                    <Separator Margin="2,14,2,8" />
                    <TextBlock Text="Provider catalog"
                               FontWeight="SemiBold"
                               Margin="4,0,4,4" />
                    <Button Content="Refresh metadata"
                            Command="{Binding RefreshProviderCatalogCommand}"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Refresh inert provider metadata"
                            AutomationProperties.HelpText="Reads target-free provider descriptions. This does not authorize or activate a provider." />
                    <Button Content="View current snapshot"
                            Command="{Binding LoadProviderCatalogCommand}"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="View current provider metadata snapshot"
                            AutomationProperties.HelpText="Reads the current Hub snapshot without launching or refreshing any provider." />
                    <TextBlock Text="{Binding ProviderCatalogStatusText}"
                               Margin="4,4"
                               TextWrapping="Wrap"
                               FontSize="11"
                               AutomationProperties.Name="{Binding ProviderCatalogStatusText}" />
                    <ItemsControl ItemsSource="{Binding ProviderCatalogEntries}"
                                  Margin="4,2"
                                  AutomationProperties.Name="Provider metadata states">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding CatalogId}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding Reason}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Opacity="0.75" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="M1 local monitoring&#x0a;No ADB required"
                           Opacity="0.75"
                           Margin="4" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               AutomationProperties.Name="{Binding SummaryText}" />
                    <TextBlock Text="{Binding AsOfText}" Opacity="0.75" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <TextBlock Text="Local Hub"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="EndpointBox"
                             Width="260"
                             Text="{Binding HubAddress, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Local Fleet Hub address"
                             AutomationProperties.HelpText="Only an absolute loopback HTTP address is accepted." />
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            AutomationProperties.Name="Connect to local Fleet Hub" />
                    <Button x:Name="SyncUpdatesButton"
                            Content="Check updates"
                            Command="{Binding SynchronizeUpdatesCommand}"
                            AutomationProperties.Name="Check for Fleet Hub updates"
                            AutomationProperties.HelpText="Reads bounded monotonic Hub events, then verifies the canonical fleet scope without live reordering." />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search devices"
                             AutomationProperties.HelpText="Matches device display name or stable device identifier." />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved view"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SavedViewBox"
                              Grid.Column="1"
                              ItemsSource="{Binding SavedViews}"
                              SelectedItem="{Binding SelectedSavedView}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Saved fleet view" />
                    <TextBox x:Name="SavedViewNameBox"
                             Grid.Column="2"
                             Margin="8,0,8,0"
                             Text="{Binding SavedViewName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Saved-view name"
                             AutomationProperties.HelpText="Enter a name to create or update a canonical Fleet Hub saved view." />
                    <Button Grid.Column="3"
                            Content="Save current"
                            Click="OnSaveCurrentView"
                            AutomationProperties.Name="Save current fleet view" />
                    <Button Grid.Column="4"
                            Content="Apply"
                            Command="{Binding ApplySavedViewCommand}"
                            AutomationProperties.Name="Apply selected saved view" />
                    <Button Grid.Column="5"
                            Content="Delete"
                            Command="{Binding DeleteSavedViewCommand}"
                            AutomationProperties.Name="Delete selected saved view" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Freshness"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding FreshnessOptions}"
                              SelectedItem="{Binding SelectedFreshness}"
                              AutomationProperties.Name="Freshness filter" />
                    <TextBlock Grid.Column="2"
                               Text="Group by"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding GroupingOptions}"
                              SelectedItem="{Binding SelectedGrouping}"
                              AutomationProperties.Name="Group devices by" />
                    <TextBlock Grid.Column="4"
                               Text="Sort by"
                               Margin="16,0,8,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SortFieldBox"
                              Grid.Column="5"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              AutomationProperties.Name="Sort devices by" />
                    <ComboBox x:Name="SortDirectionBox"
                              Grid.Column="6"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding SortDirectionOptions}"
                              SelectedItem="{Binding SelectedSortDirection}"
                              AutomationProperties.Name="Sort direction" />
                    <Button Grid.Column="8"
                            Content="Apply scope"
                            Command="{Binding ApplySearchCommand}" />
                    <Button Grid.Column="9"
                            Content="Clear scope"
                            Command="{Binding ClearSearchCommand}" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="8,5"
                    Margin="0,0,0,8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveScopeText}"
                               Margin="0,0,0,3"
                               AutomationProperties.Name="{Binding ActiveScopeText}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Select all shown"
                                    Command="{Binding SelectAllVisibleCommand}" />
                            <Button Content="Clear selection"
                                    Command="{Binding ClearBatchSelectionCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BatchSelectionText}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{Binding BatchSelectionText}" />
                    </DockPanel>
                    <DockPanel Margin="0,5,0,0">
                        <Button x:Name="ApplyLiveOrderingButton"
                                DockPanel.Dock="Right"
                                Content="Apply live ordering"
                                Command="{Binding ApplyQueuedOrderingChangesCommand}"
                                AutomationProperties.Name="{Binding OrderingChangesText}"
                                AutomationProperties.HelpText="Applies queued live membership, ordering, and grouping changes while preserving identity-based selection." />
                        <TextBlock Text="{Binding OrderingChangesText}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{Binding OrderingChangesText}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Expander x:Name="BatchOperationsExpander"
                      Grid.Row="3"
                      Header="Operations"
                      IsExpanded="False"
                      MaxHeight="180"
                      Margin="0,0,0,8"
                      AutomationProperties.Name="Operations"
                      AutomationProperties.HelpText="Expands one Windows-host singleton workflow and selected-device batch workflows. Windows host controls are independent of selected devices.">
                <ScrollViewer x:Name="BatchOperationsScrollViewer"
                              MaxHeight="140"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              AutomationProperties.Name="Operations content">
                    <StackPanel>
                    <Border x:Name="WindowsHotspotOperationPane"
                            Padding="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            AutomationProperties.Name="Windows host Mobile Hotspot operation"
                            AutomationProperties.HelpText="This host-scoped singleton affects the Windows PC running Fleet Hub. It is independent of selected devices, displays only sanitized status facts, and never adopts or stops an externally owned hotspot.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding WindowsHotspotInputLockText}"
                                           FontStyle="Italic"
                                           Opacity="0.75"
                                           AutomationProperties.Name="{Binding WindowsHotspotInputLockText}" />
                                <TextBlock Text="Windows host · Mobile Hotspot"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Text="Host-scoped singleton · does not use selected devices. An external active hotspot is observe-only; Fleet will not adopt or stop it."
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Windows Mobile Hotspot is a host-scoped singleton independent of selected devices. External hotspots are observe-only." />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Action"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="WindowsHotspotActionBox"
                                          Grid.Column="1"
                                          ItemsSource="{Binding WindowsHotspotActionOptions}"
                                          SelectedItem="{Binding SelectedWindowsHotspotAction}"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding IsWindowsHotspotInputUnlocked}"
                                          AutomationProperties.Name="Windows host Mobile Hotspot action"
                                          AutomationProperties.HelpText="{Binding WindowsHotspotActionHelpText}" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding WindowsHotspotActionHelpText}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding WindowsHotspotActionHelpText}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding WindowsHotspotConfirmationText}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="{Binding WindowsHotspotConfirmationText}" />
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding WindowsHotspotSummaryText}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding WindowsHotspotSummaryText}" />
                                <WrapPanel Grid.Row="1"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right">
                                    <Button x:Name="PreviewWindowsHotspotButton"
                                            Content="Preview host action"
                                            Command="{Binding PreviewWindowsHotspotCommand}"
                                            AutomationProperties.Name="Preview Windows host Mobile Hotspot action"
                                            AutomationProperties.HelpText="Creates an immutable host-scoped preview without changing the hotspot or using selected devices." />
                                    <Button x:Name="ConfirmWindowsHotspotButton"
                                            Content="{Binding WindowsHotspotConfirmButtonText}"
                                            Command="{Binding ConfirmWindowsHotspotCommand}"
                                            AutomationProperties.Name="Confirm the exact immutable Windows host Mobile Hotspot preview"
                                            AutomationProperties.HelpText="{Binding WindowsHotspotConfirmationText}" />
                                    <Button x:Name="RefreshWindowsHotspotButton"
                                            Content="Refresh operation"
                                            Command="{Binding RefreshWindowsHotspotCommand}"
                                            AutomationProperties.Name="Refresh Windows host Mobile Hotspot operation"
                                            AutomationProperties.HelpText="Reads the durable operation record. A fresh host readback requires a new Status preview and confirmation." />
                                    <Button x:Name="DismissWindowsHotspotButton"
                                            Content="Close view"
                                            Command="{Binding DismissWindowsHotspotCommand}"
                                            AutomationProperties.Name="Close Windows host Mobile Hotspot view"
                                            AutomationProperties.HelpText="Clears only this Console view. It does not stop the hotspot or cancel or release host work." />
                                </WrapPanel>
                            </Grid>
                            <TextBlock Text="{Binding WindowsHotspotStatusText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding WindowsHotspotStatusText}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Border x:Name="WindowsHotspotResultPane"
                                    Margin="0,6,0,0"
                                    Padding="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    DataContext="{Binding WindowsHotspotResult}"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    AutomationProperties.HelpText="Sanitized host result containing only provider readiness, singleton availability, activity, ownership, eligibility, lifecycle, expiry, and bounded public readback facts.">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}"
                                                         Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Provider" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Provider}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Singleton lease" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Lease}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Activity" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Ownership" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Ownership}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Eligibility" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Eligibility}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Lifecycle" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Lifecycle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Preview expiry" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Expires}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Outcome" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Observed" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Observed}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Capability" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Capability}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Operational state" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OperationalState}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Connected clients" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Clients}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Band" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Band}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="Source connectivity" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceConnectivity}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="OperationPane"
                            Margin="0,8,0,0"
                            Padding="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            AutomationProperties.Name="Kiosk show-controls operation"
                            AutomationProperties.HelpText="Preview the exact selected device identity revisions, review server-owned eligibility, then explicitly confirm the immutable operation.">
                        <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding OperationSummaryText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding OperationSummaryText}" />
                        <WrapPanel Grid.Row="1"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right">
                            <Button x:Name="PreviewKioskShowControlsButton"
                                    Content="Preview Show Kiosk controls"
                                    Command="{Binding PreviewKioskShowControlsCommand}"
                                    AutomationProperties.Name="Preview Show Kiosk controls for exact selected devices" />
                            <Button x:Name="ConfirmKioskShowControlsButton"
                                    Content="Confirm and run"
                                    Command="{Binding ConfirmOperationCommand}"
                                    AutomationProperties.Name="Confirm and run Show Kiosk controls for the previewed operation"
                                    AutomationProperties.HelpText="Confirms the displayed operation identifier and immutable preview identifier; it does not recompute target policy." />
                            <Button x:Name="RefreshOperationButton"
                                    Content="Refresh results"
                                    Command="{Binding RefreshOperationCommand}"
                                    AutomationProperties.Name="Refresh operation results" />
                            <Button x:Name="DismissOperationButton"
                                    Content="Dismiss"
                                    Command="{Binding DismissOperationCommand}"
                                    AutomationProperties.Name="Dismiss operation projection" />
                        </WrapPanel>
                    </Grid>
                    <TextBlock Text="{Binding OperationStatusText}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding OperationStatusText}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ScrollViewer MaxHeight="150"
                                  Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ItemsControl ItemsSource="{Binding OperationTargets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4"
                                            Margin="0,0,0,3"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding IdentityRevision, StringFormat={}Identity revision {0}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Eligibility" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Eligibility}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Lifecycle" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Lifecycle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ReasonCode, StringFormat={}Reason {0}}"
                                                           Opacity="0.75" />
                                                <TextBlock Opacity="0.75">
                                                    <Run Text="Retry " />
                                                    <Run Text="{Binding RetryDisposition, Mode=OneWay}" />
                                                    <Run Text=" · cancellation " />
                                                    <Run Text="{Binding CancelDisposition, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ReceiptId, StringFormat={}Receipt {0}, TargetNullValue=No receipt}"
                                                           Opacity="0.75" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuestAwakeOperationPane"
                            Margin="0,8,0,0"
                            Padding="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            AutomationProperties.Name="Headset awake controls"
                            AutomationProperties.HelpText="Preview exact selected identities, review per-device eligibility, then explicitly confirm. Meta keep-awake is bounded to eight hours. The Quest watchdog stops on reboot. Stopping watchdogs leaves awake settings unchanged; Restore normal is a separate action.">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding QuestAwakeInputLockText}"
                                           FontStyle="Italic"
                                           Opacity="0.75"
                                           AutomationProperties.Name="{Binding QuestAwakeInputLockText}" />
                                <TextBlock Text="Headset awake controls"
                                           FontWeight="SemiBold" />
